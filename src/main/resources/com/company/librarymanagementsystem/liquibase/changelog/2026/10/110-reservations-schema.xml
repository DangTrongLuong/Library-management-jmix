<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- ChangeSet: Create RESERVATIONS table -->
    <changeSet id="20261022-20-create-reservations" author="Library-Management-System">
        <validCheckSum>any</validCheckSum>
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="RESERVATIONS"/>
            </not>
        </preConditions>
        <createTable tableName="RESERVATIONS">
            <column name="ID" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="MEMBER_ID" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="FK_RESERVATIONS_ON_MEMBER"
                             references="MEMBERS(ID)"/>
            </column>
            <column name="BOOK_ID" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="FK_RESERVATIONS_ON_BOOK"
                             references="BOOKS(ID)"/>
            </column>
            <column name="COPY_ID" type="BIGINT">
                <constraints foreignKeyName="FK_RESERVATIONS_ON_COPY"
                             references="BOOK_COPIES(ID)"/>
            </column>
            <column name="STATUS" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
            <column name="RESERVED_AT" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="NOTIFIED_AT" type="TIMESTAMP"/>
            <column name="HOLD_EXPIRES_AT" type="TIMESTAMP"/>
            <column name="FULFILLED_LOAN_ITEM_ID" type="BIGINT">
                <constraints foreignKeyName="FK_RESERVATIONS_ON_LOAN_ITEM"
                             references="LOAN_ITEMS(ID)"/>
            </column>
            <column name="CANCEL_REASON" type="VARCHAR(255)"/>
            <column name="CANCELLED_AT" type="TIMESTAMP"/>
            <column name="CANCELLED_BY_ID" type="CHAR(36)">
                <constraints foreignKeyName="FK_RESERVATIONS_ON_CANCELLED_BY"
                             references="USER_(ID)"/>
            </column>
            <column name="CREATED_AT" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="UPDATED_AT" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <createIndex tableName="RESERVATIONS" indexName="IDX_RESERVATIONS_ON_BOOK_STATUS">
            <column name="BOOK_ID"/>
            <column name="STATUS"/>
            <column name="RESERVED_AT"/>
        </createIndex>

        <createIndex tableName="RESERVATIONS" indexName="IDX_RESERVATIONS_ON_MEMBER_STATUS">
            <column name="MEMBER_ID"/>
            <column name="STATUS"/>
        </createIndex>

        <createIndex tableName="RESERVATIONS" indexName="IDX_RESERVATIONS_ON_COPY">
            <column name="COPY_ID"/>
        </createIndex>

        <createIndex tableName="RESERVATIONS" indexName="IDX_RESERVATIONS_ON_HOLD_EXPIRES">
            <column name="STATUS"/>
            <column name="HOLD_EXPIRES_AT"/>
        </createIndex>
    </changeSet>

</databaseChangeLog>
