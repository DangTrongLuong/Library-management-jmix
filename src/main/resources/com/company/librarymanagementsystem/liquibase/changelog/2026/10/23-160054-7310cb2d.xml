<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="1" author="Library-Management-System">
        <createIndex indexName="IDX_AUDIT_ON_ACTION" tableName="AUDIT_LOGS">
            <column name="ACTION"/>
        </createIndex>
    </changeSet>
    <changeSet id="2" author="Library-Management-System">
        <createIndex indexName="IDX_AUDIT_ON_CREATED_AT" tableName="AUDIT_LOGS">
            <column name="CREATED_AT"/>
        </createIndex>
    </changeSet>
    <changeSet id="3" author="Library-Management-System">
        <createIndex indexName="IDX_AUDIT_ON_ENTITY" tableName="AUDIT_LOGS">
            <column name="ENTITY_NAME"/>
        </createIndex>
    </changeSet>
    <changeSet id="4" author="Library-Management-System">
        <createIndex indexName="IDX_AUDIT_ON_USER" tableName="AUDIT_LOGS">
            <column name="USERNAME"/>
        </createIndex>
    </changeSet>
    <changeSet id="5" author="Library-Management-System">
        <addNotNullConstraint columnDataType="${offsetDateTime.type}" columnName="CREATED_AT" tableName="AUDIT_LOGS"
                              validate="true"/>
    </changeSet>
    <changeSet id="6" author="Library-Management-System">
        <modifyDataType columnName="DETAILS" newDataType="VARCHAR(2000)" tableName="AUDIT_LOGS"/>
    </changeSet>
</databaseChangeLog>