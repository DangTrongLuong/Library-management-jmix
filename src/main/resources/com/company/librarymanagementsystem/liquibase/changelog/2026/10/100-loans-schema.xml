<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">

    <!-- ChangeSet 1: Create LOANS table -->
    <changeSet id="20261022-10-create-loans" author="Library-Management-System">
        <createTable tableName="LOANS">
            <column name="ID" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="LOAN_CODE" type="VARCHAR(30)">
                <constraints nullable="false" unique="true" uniqueConstraintName="UC_LOANS_LOAN_CODE"/>
            </column>
            <column name="MEMBER_ID" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="FK_LOANS_ON_MEMBER"
                             references="MEMBERS(ID)"/>
            </column>
            <column name="ISSUED_BY_ID" type="${uuid.type}">
                <constraints nullable="false"
                             foreignKeyName="FK_LOANS_ON_ISSUED_BY"
                             references="USER_(ID)"/>
            </column>
            <column name="LOAN_DATE" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="NOTE" type="VARCHAR(255)"/>
            <column name="CREATED_AT" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="UPDATED_AT" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <createIndex tableName="LOANS" indexName="IDX_LOANS_ON_MEMBER">
            <column name="MEMBER_ID"/>
            <column name="LOAN_DATE"/>
        </createIndex>
    </changeSet>

    <!-- ChangeSet 2: Create LOAN_ITEMS table -->
    <changeSet id="20261022-11-create-loan-items" author="Library-Management-System">
        <createTable tableName="LOAN_ITEMS">
            <column name="ID" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="LOAN_ID" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="FK_LOAN_ITEMS_ON_LOAN"
                             references="LOANS(ID)"/>
            </column>
            <column name="COPY_ID" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="FK_LOAN_ITEMS_ON_COPY"
                             references="BOOK_COPIES(ID)"/>
            </column>
            <column name="DUE_DATE" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="RETURNED_AT" type="TIMESTAMP"/>
            <column name="RECEIVED_BY_ID" type="${uuid.type}">
                <constraints foreignKeyName="FK_LOAN_ITEMS_ON_RECEIVED_BY"
                             references="USER_(ID)"/>
            </column>
            <column name="RENEW_COUNT" type="INT" defaultValueNumeric="0">
                <constraints nullable="false"/>
            </column>
            <column name="STATUS" type="VARCHAR(20)" defaultValue="BORROWED">
                <constraints nullable="false"/>
            </column>
            <column name="RETURN_CONDITION" type="VARCHAR(20)"/>
            <column name="NOTE" type="VARCHAR(255)"/>
            <column name="CREATED_AT" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="UPDATED_AT" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <createIndex tableName="LOAN_ITEMS" indexName="IDX_LOAN_ITEMS_ON_STATUS_DUE">
            <column name="STATUS"/>
            <column name="DUE_DATE"/>
        </createIndex>
        <createIndex tableName="LOAN_ITEMS" indexName="IDX_LOAN_ITEMS_ON_COPY_STATUS">
            <column name="COPY_ID"/>
            <column name="STATUS"/>
        </createIndex>
    </changeSet>

    <!-- ChangeSet 3: Create RENEWALS table -->
    <changeSet id="20261022-12-create-renewals" author="Library-Management-System">
        <createTable tableName="RENEWALS">
            <column name="ID" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="LOAN_ITEM_ID" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="FK_RENEWALS_ON_LOAN_ITEM"
                             references="LOAN_ITEMS(ID)"/>
            </column>
            <column name="OLD_DUE_DATE" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="NEW_DUE_DATE" type="DATE">
                <constraints nullable="false"/>
            </column>
            <column name="RENEWED_BY_ID" type="${uuid.type}">
                <constraints nullable="false"
                             foreignKeyName="FK_RENEWALS_ON_RENEWED_BY"
                             references="USER_(ID)"/>
            </column>
            <column name="CHANNEL" type="VARCHAR(20)" defaultValue="COUNTER">
                <constraints nullable="false"/>
            </column>
            <column name="RENEWED_AT" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="NOTE" type="VARCHAR(255)"/>
        </createTable>
        <createIndex tableName="RENEWALS" indexName="IDX_RENEWALS_ON_LOAN_ITEM">
            <column name="LOAN_ITEM_ID"/>
        </createIndex>
    </changeSet>

    <!-- ChangeSet 4: Create FINES table -->
    <changeSet id="20261022-13-create-fines" author="Library-Management-System">
        <createTable tableName="FINES">
            <column name="ID" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="VERSION" type="INT" defaultValueNumeric="1">
                <constraints nullable="false"/>
            </column>
            <column name="MEMBER_ID" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="FK_FINES_ON_MEMBER"
                             references="MEMBERS(ID)"/>
            </column>
            <column name="LOAN_ITEM_ID" type="BIGINT">
                <constraints foreignKeyName="FK_FINES_ON_LOAN_ITEM"
                             references="LOAN_ITEMS(ID)"/>
            </column>
            <column name="FINE_TYPE" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>
            <column name="DAYS_OVERDUE" type="INT"/>
            <column name="AMOUNT" type="DECIMAL(12,2)">
                <constraints nullable="false"/>
            </column>
            <column name="PAID_AMOUNT" type="DECIMAL(12,2)" defaultValueNumeric="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="STATUS" type="VARCHAR(20)" defaultValue="UNPAID">
                <constraints nullable="false"/>
            </column>
            <column name="DESCRIPTION" type="VARCHAR(255)"/>
            <column name="CREATED_BY_ID" type="${uuid.type}">
                <constraints foreignKeyName="FK_FINES_ON_CREATED_BY"
                             references="USER_(ID)"/>
            </column>
            <column name="CREATED_AT" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="UPDATED_AT" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <createIndex tableName="FINES" indexName="IDX_FINES_ON_MEMBER_STATUS">
            <column name="MEMBER_ID"/>
            <column name="STATUS"/>
        </createIndex>
    </changeSet>

    <!-- ChangeSet 5: Create Views for queries and dashboards -->
    <changeSet id="20261022-14-create-loan-views" author="Library-Management-System">
        <sql splitStatements="true">
            CREATE OR REPLACE VIEW v_member_current_loans AS
            SELECT l.MEMBER_ID, COUNT(li.ID) AS CURRENT_LOANS
            FROM LOANS l
            JOIN LOAN_ITEMS li ON l.ID = li.LOAN_ID
            WHERE li.STATUS = 'BORROWED'
            GROUP BY l.MEMBER_ID;

            CREATE OR REPLACE VIEW v_member_outstanding_fines AS
            SELECT f.MEMBER_ID, SUM(f.AMOUNT - f.PAID_AMOUNT) AS TOTAL_OUTSTANDING
            FROM FINES f
            WHERE f.STATUS IN ('UNPAID', 'PARTIAL')
            GROUP BY f.MEMBER_ID;

            CREATE OR REPLACE VIEW v_overdue_items AS
            SELECT li.ID AS LOAN_ITEM_ID, l.MEMBER_ID, li.COPY_ID, li.DUE_DATE,
                   DATEDIFF(CURDATE(), li.DUE_DATE) AS DAYS_OVERDUE
            FROM LOANS l
            JOIN LOAN_ITEMS li ON l.ID = li.LOAN_ID
            WHERE li.STATUS = 'BORROWED' AND li.DUE_DATE &lt; CURDATE();
        </sql>
    </changeSet>

</databaseChangeLog>
