                <indexExists indexName="IDX_LOANS_ON_LOAN_DATE" tableName="LOANS"/>
            </not>
        </preConditions>
        <createIndex indexName="IDX_LOANS_ON_LOAN_DATE" tableName="LOANS">
            <column name="LOAN_DATE"/>
        </createIndex>
    </changeSet>
    <changeSet id="perf-idx-books-status-id" author="Library-Management-System">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="IDX_BOOKS_STATUS_ID" tableName="BOOKS"/>
            </not>
        </preConditions>
        <createIndex indexName="IDX_BOOKS_STATUS_ID" tableName="BOOKS">
            <column name="STATUS"/>
            <column name="ID"/>
        </createIndex>
    </changeSet>
    <changeSet id="perf-idx-loan-items-status-id" author="Library-Management-System">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="IDX_LOAN_ITEMS_STATUS_ID" tableName="LOAN_ITEMS"/>
            </not>
        </preConditions>
        <createIndex indexName="IDX_LOAN_ITEMS_STATUS_ID" tableName="LOAN_ITEMS">
            <column name="STATUS"/>
