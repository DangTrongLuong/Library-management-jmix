        </createIndex>
    </changeSet>
    <changeSet id="perf-idx-fines-status-created" author="Library-Management-System">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="IDX_FINES_STATUS_CREATED" tableName="FINES"/>
            </not>
        </preConditions>
        <createIndex indexName="IDX_FINES_STATUS_CREATED" tableName="FINES">
            <column name="STATUS"/>
            <column name="CREATED_AT"/>
        </createIndex>
    </changeSet>
    <changeSet id="perf-idx-book-copies-book-status" author="Library-Management-System">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="IDX_BOOK_COPIES_BOOK_STATUS" tableName="BOOK_COPIES"/>
            </not>
        </preConditions>
        <createIndex indexName="IDX_BOOK_COPIES_BOOK_STATUS" tableName="BOOK_COPIES">
            <column name="BOOK_ID"/>
            <column name="STATUS"/>
        </createIndex>
    </changeSet>
    <changeSet id="cleanup-librarian-copy-edit-perm" author="Library-Management-System">
        <sql>
            DELETE FROM ROLE_PERMISSIONS 
            WHERE ROLE_ID = (SELECT ID FROM ROLES WHERE CODE = 'LIBRARIAN') 
              AND PERMISSION_ID = (SELECT ID FROM PERMISSIONS WHERE CODE = 'COPY_EDIT');
        </sql>
    </changeSet>
</databaseChangeLog>
