<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                      http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd"
        objectQuotingStrategy="QUOTE_ONLY_RESERVED_WORDS">
    <changeSet id="perf-idx-books-status" author="Library-Management-System">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="IDX_BOOKS_ON_STATUS" tableName="BOOKS"/>
            </not>
        </preConditions>
        <createIndex indexName="IDX_BOOKS_ON_STATUS" tableName="BOOKS">
            <column name="STATUS"/>
        </createIndex>
    </changeSet>
    <changeSet id="perf-idx-books-title" author="Library-Management-System">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="IDX_BOOKS_ON_TITLE" tableName="BOOKS"/>
            </not>
        </preConditions>
        <createIndex indexName="IDX_BOOKS_ON_TITLE" tableName="BOOKS">
            <column name="TITLE"/>
        </createIndex>
    </changeSet>
    <changeSet id="perf-idx-fines-status" author="Library-Management-System">
        <preConditions onFail="MARK_RAN">
            <not>
                <indexExists indexName="IDX_FINES_ON_STATUS" tableName="FINES"/>
            </not>
        </preConditions>
        <createIndex indexName="IDX_FINES_ON_STATUS" tableName="FINES">
            <column name="STATUS"/>
        </createIndex>
    </changeSet>
