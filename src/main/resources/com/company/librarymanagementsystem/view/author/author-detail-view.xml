<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="Chi tiết Tác giả">
    <data>
        <instance id="authorDc"
                  class="com.company.librarymanagementsystem.entity.Author">
            <fetchPlan extends="_base"/>
            <loader/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose" text="Lưu và Đóng"/>
        <action id="closeAction" type="detail_close" text="Đóng"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="authorDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="35em" columns="2"/>
            </responsiveSteps>

            <textField id="fullNameField"
                       property="fullName"
                       label="Họ và tên tác giả"
                       required="true"
                       requiredMessage="Vui lòng nhập họ và tên tác giả"
                       colspan="2"/>

            <textField id="birthYearField"
                       property="birthYear"
                       label="Năm sinh / Thời kỳ"/>

            <textField id="nationalityField"
                       property="nationality"
                       label="Quốc tịch"/>

            <textArea id="biographyField"
                      property="biography"
                      label="Tiểu sử / Tác phẩm tiêu biểu"
                      height="8em"
                      colspan="2"/>
        </formLayout>

        <hbox id="detailActions" spacing="true" classNames="mt-m">
            <button id="saveAndCloseButton" action="saveCloseAction" themeNames="primary" icon="CHECK"/>
            <button id="closeButton" action="closeAction" icon="BAN"/>
        </hbox>
    </layout>
</view>
