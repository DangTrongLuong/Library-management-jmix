<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="Chi tiết Thể loại">
    <data>
        <instance id="categoryDc"
                  class="com.company.librarymanagementsystem.entity.Category">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_base"/>
            </fetchPlan>
            <loader/>
        </instance>
    </data>
    <facets>
        <dataLoadCoordinator auto="true"/>
    </facets>
    <actions>
        <action id="saveCloseAction" type="detail_saveClose" text="Lưu và Đóng"/>
        <action id="closeAction" type="detail_close" text="Đóng"/>
    </actions>
    <layout>
        <formLayout id="form" dataContainer="categoryDc">
            <responsiveSteps>
                <responsiveStep minWidth="0" columns="1"/>
                <responsiveStep minWidth="35em" columns="2"/>
            </responsiveSteps>

            <textField id="nameField"
                       property="name"
                       label="Tên thể loại"
                       required="true"
                       requiredMessage="Vui lòng nhập tên thể loại"
                       colspan="2"/>

            <entityPicker id="parentField"
                          property="parent"
                          label="Thuộc thể loại cha (để trống nếu là danh mục gốc)"
                          colspan="2">
                <actions>
                    <action id="entityLookup" type="entity_lookup"/>
                    <action id="entityClear" type="entity_clear"/>
                </actions>
            </entityPicker>

            <textField id="ddcCodeField"
                       property="ddcCode"
                       label="Mã phân loại DDC (Dewey)"/>

            <textField id="slugField"
                       property="slug"
                       label="Mã Slug (tự động tạo nếu để trống)"/>

            <textField id="descriptionField"
                       property="description"
                       label="Mô tả thể loại"
                       colspan="2"/>
        </formLayout>

        <hbox id="detailActions" spacing="true" classNames="mt-m">
            <button id="saveAndCloseButton" action="saveCloseAction" themeNames="primary" icon="CHECK"/>
            <button id="closeButton" action="closeAction" icon="BAN"/>
        </hbox>
    </layout>
</view>
