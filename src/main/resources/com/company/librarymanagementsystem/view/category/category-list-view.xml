<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="Quản lý Thể loại"
      focusComponent="categoriesDataGrid">
    <data>
        <collection id="categoriesDc"
                    class="com.company.librarymanagementsystem.entity.Category">
            <fetchPlan extends="_base">
                <property name="parent" fetchPlan="_base"/>
            </fetchPlan>
            <loader id="categoriesDl" readOnly="true">
                <query>
                    <![CDATA[select e from Category e order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel" alignItems="CENTER" width="100%" spacing="true">
            <button id="createButton" action="categoriesDataGrid.createAction" text="Thêm mới" icon="PLUS" themeNames="primary"/>
            <button id="editButton" action="categoriesDataGrid.editAction" text="Chỉnh sửa" icon="PENCIL"/>
            <button id="removeButton" action="categoriesDataGrid.removeAction" text="Xóa" icon="TRASH" themeNames="error"/>
            <button id="refreshButton" action="categoriesDataGrid.refreshAction" text="Làm mới" icon="REFRESH"/>
            
            <textField id="searchField"
                       placeholder="Tìm kiếm thể loại theo tên, mã DDC..."
                       clearButtonVisible="true"
                       prefixComponent="vaadin-icon:search"
                       width="24em"
                       classNames="ms-m"/>

            <simplePagination id="pagination" dataLoader="categoriesDl" classNames="ms-auto"/>
        </hbox>

        <dataGrid id="categoriesDataGrid"
                  width="100%"
                  selectionMode="MULTI"
                  columnReorderingAllowed="true"
                  minHeight="24em"
                  dataContainer="categoriesDc">
            <actions>
                <action id="createAction" type="list_create" text="Thêm mới"/>
                <action id="editAction" type="list_edit" text="Chỉnh sửa"/>
                <action id="removeAction" type="list_remove" text="Xóa"/>
                <action id="refreshAction" type="list_refresh" text="Làm mới"/>
            </actions>
            <columns resizable="true">
                <column property="name" header="Tên Thể loại" autoWidth="true" flexGrow="1"/>
                <column property="parent" header="Thể loại cha" autoWidth="true" flexGrow="0"/>
                <column property="ddcCode" header="Mã DDC" autoWidth="true" flexGrow="0" textAlign="CENTER"/>
                <column property="slug" header="Mã Slug" autoWidth="true" flexGrow="0"/>
                <column property="description" header="Mô tả" autoWidth="true" flexGrow="2"/>
            </columns>
        </dataGrid>

        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction" text="Chọn" themeNames="primary" icon="CHECK"/>
            <button id="discardButton" action="discardAction" text="Bỏ qua" icon="BAN"/>
        </hbox>
    </layout>
</view>
