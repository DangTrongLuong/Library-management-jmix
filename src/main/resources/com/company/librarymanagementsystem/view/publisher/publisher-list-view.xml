<?xml version="1.0" encoding="UTF-8" standalone="no"?>
<view xmlns="http://jmix.io/schema/flowui/view"
      title="Quản lý Nhà xuất bản"
      focusComponent="publishersDataGrid">
    <data>
        <collection id="publishersDc"
                    class="com.company.librarymanagementsystem.entity.Publisher">
            <fetchPlan extends="_base"/>
            <loader id="publishersDl" readOnly="true">
                <query>
                    <![CDATA[select e from Publisher e order by e.name]]>
                </query>
            </loader>
        </collection>
    </data>
    <actions>
        <action id="selectAction" type="lookup_select"/>
        <action id="discardAction" type="lookup_discard"/>
    </actions>
    <facets>
        <dataLoadCoordinator auto="true"/>
        <urlQueryParameters>
            <pagination component="pagination"/>
        </urlQueryParameters>
    </facets>
    <layout>
        <hbox id="buttonsPanel" classNames="buttons-panel" alignItems="CENTER" width="100%" spacing="true">
            <button id="createButton" action="publishersDataGrid.createAction" text="Thêm mới" icon="PLUS" themeNames="primary"/>
            <button id="editButton" action="publishersDataGrid.editAction" text="Chỉnh sửa" icon="PENCIL"/>
            <button id="removeButton" action="publishersDataGrid.removeAction" text="Xóa" icon="TRASH" themeNames="error"/>
            <button id="refreshButton" action="publishersDataGrid.refreshAction" text="Làm mới" icon="REFRESH"/>
            
            <textField id="searchField"
                       placeholder="Tìm kiếm NXB theo tên, địa chỉ, email, số điện thoại..."
                       clearButtonVisible="true"
                       prefixComponent="vaadin-icon:search"
                       width="26em"
                       classNames="ms-m"/>

            <simplePagination id="pagination" dataLoader="publishersDl" classNames="ms-auto"/>
        </hbox>

        <dataGrid id="publishersDataGrid"
                  width="100%"
                  columnReorderingAllowed="true"
                  minHeight="24em"
                  dataContainer="publishersDc">
            <actions>
                <action id="createAction" type="list_create" text="Thêm mới"/>
                <action id="editAction" type="list_edit" text="Chỉnh sửa"/>
                <action id="removeAction" type="list_remove" text="Xóa"/>
                <action id="refreshAction" type="list_refresh" text="Làm mới"/>
            </actions>
            <columns resizable="true">
                <column property="name" header="Tên Nhà xuất bản" autoWidth="true" flexGrow="1"/>
                <column property="address" header="Địa chỉ" autoWidth="true" flexGrow="2"/>
                <column property="phone" header="Số điện thoại" autoWidth="true" flexGrow="0"/>
                <column property="email" header="Email" autoWidth="true" flexGrow="0"/>
            </columns>
        </dataGrid>

        <hbox id="lookupActions" visible="false">
            <button id="selectButton" action="selectAction" text="Chọn"/>
            <button id="discardButton" action="discardAction" text="Bỏ qua"/>
        </hbox>
    </layout>
</view>
